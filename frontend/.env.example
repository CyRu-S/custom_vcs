# For Vite development only. Browser requests still use the same-origin /api path.
CVCS_API_TARGET=http://127.0.0.1:8080

# Set this in Vercel Project Settings -> Environment Variables, then redeploy.
# Use the HTTPS origin of a tunnel/reverse proxy to the backend on this computer.
# No /api suffix, localhost address, or database credentials.
CVCS_BACKEND_ORIGIN=https://your-backend.example.com
