<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <!-- Exercise error responses without printing expected failure stack traces in test output. -->
    <logger name="com.vcs.customvcs.exception.ApiExceptionHandler" level="OFF"/>
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
