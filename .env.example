# Copy to .env in the project root. Supply your own PostgreSQL credentials.
CVCS_DB_URL=jdbc:postgresql://localhost:5432/customvcs
CVCS_DB_USERNAME=postgres
CVCS_DB_PASSWORD=replace-with-your-local-password
CVCS_STORAGE_ROOT=./data/repositories
# Set true when the application is served over HTTPS.
CVCS_SECURE_COOKIES=false

# Docker backend -> PostgreSQL already running on your computer (compose.local-db.yaml).
# Set the database name/port to match CVCS_DB_URL above; localhost inside Docker is not the host.
CVCS_DOCKER_DB_URL=jdbc:postgresql://host.docker.internal:5432/customvcs
CVCS_DOCKER_STORAGE_ROOT=./data/repositories
